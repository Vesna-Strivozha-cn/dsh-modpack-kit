{
  "name": "dsh-modpack-kit",
  "version": "0.2.1",
  "description": "谁说dsh不能整整合包呢？（你说这几个插件整一块不牛逼坏了） 把多个 DeepSeek Harness 插件连同配置与数据打成一个 .dshpack，一键安装、离线可装；三种策略、分组同源插件市场。npm：https://www.npmjs.com/package/dsh-modpack-kit",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "dsh-plugin",
    "modpack",
    "bundle",
    "pack",
    "installer",
    "plugin-manager",
    "security-scan",
    "dsh",
    "deepseek-harness",
    "dshpack",
    "plugin-bundle",
    "one-click-install",
    "offline-install",
    "migrate-plugins",
    "ai-search"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Vesna-Strivozha-cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesna-Strivozha-cn/dsh-modpack-kit.git"
  },
  "homepage": "https://github.com/Vesna-Strivozha-cn/dsh-modpack-kit#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "bugs": {
    "url": "https://github.com/Vesna-Strivozha-cn/dsh-modpack-kit/issues"
  }
}
